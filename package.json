{
  "name": "dsh-tool-manager",
  "version": "1.2.1",
  "description": "Manage DSH agent tools per preset and open on-demand tool groups for the rest of a session",
  "type": "module",
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "docs/images/tool-manager.png",
    "LICENSE",
    "package.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.5-rc.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pan17/dsh-tool-manager.git"
  },
  "bugs": {
    "url": "https://github.com/pan17/dsh-tool-manager/issues"
  },
  "homepage": "https://github.com/pan17/dsh-tool-manager#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "tools",
    "mcp"
  ]
}
